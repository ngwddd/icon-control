{
  "name": "系统文本编辑器_type_demo",
  "description": "click the 系统文本编辑器 editor and type ${text}",
  "window": {
    "process": "系统文本编辑器"
  },
  "steps": [
    {
      "action": "click",
      "rel": [
        500,
        300
      ]
    },
    {
      "action": "sleep",
      "ms": 200
    },
    {
      "action": "type",
      "text": "${text}"
    },
    {
      "action": "sleep",
      "ms": 150
    }
  ]
}
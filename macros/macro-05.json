{
  "name": "TextEditor_type_demo",
  "description": "click the TextEditor editor and type ${text}",
  "window": {
    "process": "TextEditor"
  },
  "steps": [
    {
      "action": "click",
      "rel": [
        500,
        300
      ]
    },
    {
      "action": "sleep",
      "ms": 200
    },
    {
      "action": "type",
      "text": "${text}"
    },
    {
      "action": "sleep",
      "ms": 150
    }
  ]
}